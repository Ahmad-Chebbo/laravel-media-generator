{
    "name": "ahmad-chebbo/laravel-media-generator",
    "description": "A Laravel package for generating and managing media files with Spatie Media Library integration",
    "keywords": [
        "laravel",
        "media",
        "generator",
        "spatie",
        "media-library"
    ],
    "version": "1.0.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmad Chebbo",
            "email": "ahmad.m.shebbo@gmail.com"
        },
        {
            "name": "Ahmad Seifeddine"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4|^8.5",
        "spatie/laravel-medialibrary": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "AhmadChebbo\\LaravelMediaGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AhmadChebbo\\LaravelMediaGenerator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AhmadChebbo\\LaravelMediaGenerator\\MediaGeneratorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
